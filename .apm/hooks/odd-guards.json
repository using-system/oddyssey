{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/guard_default_branch.py PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/scan_odd_identifiers.py PostToolUse",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
